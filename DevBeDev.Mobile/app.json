{
  "expo": {
    "name": "DevBeDev",
    "slug": "devbedev-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/imagemlogo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/imagemlogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#121214"
    },
    "android": {
      "package": "com.thainapaiva.devbedev",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/imagemlogo.png",
        "backgroundColor": "#121214"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "60263a35-7a75-41d6-bcde-1221e60994e9"
      }
    }
  }
}
